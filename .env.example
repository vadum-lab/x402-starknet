# x402 Starknet — environment variables. Copy to .env. NEVER commit a real key. Testnet (Sepolia) only.

# === Facilitator (Node sidecar) — SELF-SUBMIT mode by default (no AVNU) =====================
STARKNET_RPC_URL=                 # Starknet Sepolia RPC (e.g. Alchemy free tier)
X402_PAY_TO=                      # Starknet address receiving payments (also an optional allow-list at the facilitator)
FACILITATOR_ADDRESS=              # facilitator Sepolia account, funded in STRK for gas
FACILITATOR_PRIVATE_KEY=          # facilitator private key — SECRET, never commit
X402_NETWORK=starknet:SN_SEPOLIA   # CAIP-2 id (starknet:SN_SEPOLIA or starknet:SN_MAIN); the RPC node must be on it
# X402_SETTLE_WAIT_MS=60000       # how long /settle waits for an outcome before answering settlement_pending
X402_ASSET=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d  # STRK Sepolia (18 dec) — public contract address

# === Facilitator — AVNU paymaster mode (NOT migrated to the registered scheme; `npm run start:avnu`) ==
PAYMASTER_ENDPOINT=               # AVNU paymaster endpoint (Sepolia)
PAYMASTER_API_KEY=                # AVNU API key

# === Example server (gates a resource behind payment) ======================================
FACILITATOR_URL=http://localhost:3402   # where the server reaches the facilitator (docker: http://x402-facilitator:3000)
X402_AMOUNT=50000000000000000           # price in atomic units of the asset (default 0.05 STRK, 18 dec)
# X402_ASSET / X402_NETWORK — shared with the facilitator above
# X402_MAX_TIMEOUT_SECONDS=300      # payment window advertised in the 402 (must exceed 30 s)
# The server needs no key: it copies the feePayer from the facilitator's /supported.

# === Demo client (paying agent) ============================================================
PAYER_ADDRESS=                    # payer Sepolia account, funded with the asset (STRK)
PAYER_PRIVATE_KEY=                # payer private key — SECRET, never commit
X402_ENDPOINT=http://localhost:8000/x402/hello   # the example server below (or any x402 server)
